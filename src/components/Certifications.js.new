    },
    {
      title: "Data Analyst Internship",
      date: "Mai 2024 - Juin 2024",
      provider: "Mentorness",
      icon: "📊"
    },
    {
      title: "Reinforcement Learning",
      date: "Octobre 2025",
      provider: "DataCamp",
      icon: "🎮"
    },
    {
      title: "Deep Reinforcement Learning in Python",
      date: "Octobre 2025",
